{
  "name": "generador-de-facturas",
  "version": "1.0.0",
  "description": "Aplicación de escritorio Windows para generación de facturas en PDF organizadas por año y mes",
  "main": "main.js",
  "scripts": {
    "start": "node node_modules/electron/cli.js .",
    "test": "node node_modules/electron/cli.js tests/test_suite.js",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.humono.generadordefacturas",
    "productName": "Generador de Facturas",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "config.json",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Generador de Facturas"
    }
  },
  "keywords": [
    "facturas",
    "pdf",
    "electron",
    "desktop",
    "windows"
  ],
  "author": "humono",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.1"
  }
}
